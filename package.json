{
  "name": "subsidium",
  "version": "0.5.0",
  "description": "Operational-assistance framework: humans are the most expensive tier. Drive an existing system with agents, escalate to people only what has proven it needs them.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./ui/styles.css": "./ui/styles.css"
  },
  "files": [
    "dist",
    "ui/styles.css",
    "PRINCIPLES.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "loic001",
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "subsidiarity",
    "human-in-the-loop",
    "escalation",
    "operations",
    "agents",
    "panarchy",
    "attention-budget"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loic001/subsidium.git"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "sim": "tsx bench/report.ts",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run coverage && npm run build"
  },
  "devDependencies": {
    "@mastra/core": "^1.63.2",
    "@types/react": "^19.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.4",
    "zod": "^4.5.4"
  }
}
